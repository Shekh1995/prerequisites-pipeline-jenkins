#!/bin/bash

# ============================================================
# AWS ACTIVE RESOURCE CHECK
# Run from AWS CloudShell
# ============================================================

set -u

echo
echo "============================================================"
echo "          AWS ACTIVE RESOURCE REPORT"
echo "============================================================"
echo

ACCOUNT_ID=$(aws sts get-caller-identity \
  --query Account \
  --output text 2>/dev/null)

echo "AWS Account : $ACCOUNT_ID"
echo "Generated   : $(date)"
echo

# ------------------------------------------------------------
# TABLE HEADER
# ------------------------------------------------------------

printf "%-20s %-12s %-12s %-50s\n" \
"REGION" "SERVICE" "COUNT" "RESOURCE"

echo "------------------------------------------------------------------------------------------"

# ------------------------------------------------------------
# REGIONS
# ------------------------------------------------------------

REGIONS=$(aws ec2 describe-regions \
  --query 'Regions[].RegionName' \
  --output text)

# ------------------------------------------------------------
# CHECK EACH REGION
# ------------------------------------------------------------

for REGION in $REGIONS
do

    # ========================================================
    # EC2 RUNNING INSTANCES
    # ========================================================

    EC2=$(aws ec2 describe-instances \
      --region "$REGION" \
      --filters "Name=instance-state-name,Values=running" \
      --query 'Reservations[].Instances[].InstanceId' \
      --output text 2>/dev/null)

    if [ -n "$EC2" ] && [ "$EC2" != "None" ]; then
        COUNT=$(echo "$EC2" | wc -w)

        for ID in $EC2
        do
            TYPE=$(aws ec2 describe-instances \
              --region "$REGION" \
              --instance-ids "$ID" \
              --query 'Reservations[0].Instances[0].InstanceType' \
              --output text)

            printf "%-20s %-12s %-12s %-50s\n" \
            "$REGION" "EC2" "$COUNT" "$ID ($TYPE)"
        done
    fi

    # ========================================================
    # RDS DATABASES
    # ========================================================

    RDS=$(aws rds describe-db-instances \
      --region "$REGION" \
      --query 'DBInstances[?DBInstanceStatus==`available`].DBInstanceIdentifier' \
      --output text 2>/dev/null)

    if [ -n "$RDS" ] && [ "$RDS" != "None" ]; then
        COUNT=$(echo "$RDS" | wc -w)

        for DB in $RDS
        do
            printf "%-20s %-12s %-12s %-50s\n" \
            "$REGION" "RDS" "$COUNT" "$DB"
        done
    fi

    # ========================================================
    # EKS CLUSTERS
    # ========================================================

    EKS=$(aws eks list-clusters \
      --region "$REGION" \
      --query 'clusters[]' \
      --output text 2>/dev/null)

    if [ -n "$EKS" ] && [ "$EKS" != "None" ]; then
        COUNT=$(echo "$EKS" | wc -w)

        for CLUSTER in $EKS
        do
            printf "%-20s %-12s %-12s %-50s\n" \
            "$REGION" "EKS" "$COUNT" "$CLUSTER"
        done
    fi

    # ========================================================
    # ECS CLUSTERS
    # ========================================================

    ECS=$(aws ecs list-clusters \
      --region "$REGION" \
      --query 'clusterArns[]' \
      --output text 2>/dev/null)

    if [ -n "$ECS" ] && [ "$ECS" != "None" ]; then

        for CLUSTER in $ECS
        do
            RUNNING=$(aws ecs list-tasks \
              --region "$REGION" \
              --cluster "$CLUSTER" \
              --desired-status RUNNING \
              --query 'taskArns[]' \
              --output text 2>/dev/null)

            if [ -n "$RUNNING" ] && [ "$RUNNING" != "None" ]; then
                COUNT=$(echo "$RUNNING" | wc -w)

                NAME=$(basename "$CLUSTER")

                printf "%-20s %-12s %-12s %-50s\n" \
                "$REGION" "ECS" "$COUNT" "$NAME"
            fi
        done
    fi

    # ========================================================
    # LAMBDA FUNCTIONS
    # ========================================================

    LAMBDA=$(aws lambda list-functions \
      --region "$REGION" \
      --query 'Functions[].FunctionName' \
      --output text 2>/dev/null)

    if [ -n "$LAMBDA" ] && [ "$LAMBDA" != "None" ]; then
        COUNT=$(echo "$LAMBDA" | wc -w)

        printf "%-20s %-12s %-12s %-50s\n" \
        "$REGION" "Lambda" "$COUNT" "Functions"
    fi

    # ========================================================
    # LOAD BALANCERS
    # ========================================================

    ALB=$(aws elbv2 describe-load-balancers \
      --region "$REGION" \
      --query 'LoadBalancers[].LoadBalancerName' \
      --output text 2>/dev/null)

    if [ -n "$ALB" ] && [ "$ALB" != "None" ]; then
        COUNT=$(echo "$ALB" | wc -w)

        for LB in $ALB
        do
            printf "%-20s %-12s %-12s %-50s\n" \
            "$REGION" "ALB/NLB" "$COUNT" "$LB"
        done
    fi

    # ========================================================
    # NAT GATEWAYS
    # ========================================================

    NAT=$(aws ec2 describe-nat-gateways \
      --region "$REGION" \
      --filter Name=state,Values=available \
      --query 'NatGateways[].NatGatewayId' \
      --output text 2>/dev/null)

    if [ -n "$NAT" ] && [ "$NAT" != "None" ]; then
        COUNT=$(echo "$NAT" | wc -w)

        for ID in $NAT
        do
            printf "%-20s %-12s %-12s %-50s\n" \
            "$REGION" "NAT Gateway" "$COUNT" "$ID"
        done
    fi

    # ========================================================
    # ELASTIC IPs
    # ========================================================

    EIP=$(aws ec2 describe-addresses \
      --region "$REGION" \
      --query 'Addresses[?AssociationId!=null].PublicIp' \
      --output text 2>/dev/null)

    if [ -n "$EIP" ] && [ "$EIP" != "None" ]; then
        COUNT=$(echo "$EIP" | wc -w)

        for IP in $EIP
        do
            printf "%-20s %-12s %-12s %-50s\n" \
            "$REGION" "Elastic IP" "$COUNT" "$IP"
        done
    fi

done

# ============================================================
# S3 BUCKETS
# ============================================================

echo
echo "------------------------------------------------------------------------------------------"

BUCKETS=$(aws s3api list-buckets \
  --query 'Buckets[].Name' \
  --output text 2>/dev/null)

if [ -n "$BUCKETS" ] && [ "$BUCKETS" != "None" ]; then

    COUNT=$(echo "$BUCKETS" | wc -w)

    printf "%-20s %-12s %-12s %-50s\n" \
    "GLOBAL" "S3" "$COUNT" "Buckets"

    for BUCKET in $BUCKETS
    do
        printf "%-20s %-12s %-12s %-50s\n" \
        "GLOBAL" "S3" "-" "$BUCKET"
    done
fi

echo
echo "============================================================"
echo "                 REPORT COMPLETED"
echo "============================================================"
echo
